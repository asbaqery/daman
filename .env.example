# كل هذي القيم سرية ما عدا APP_ORIGIN. تنحط في Replit Secrets، ومحليًا في .env.local. لا ترفعها على GitHub.
# رابط MongoDB Atlas لقاعدة daman
MONGODB_URI=
# نص عشوائي طويل (32 حرف على الأقل)
JWT_SECRET=
# مفتاح Stripe بوضع الاختبار فقط: sk_test_
STRIPE_SECRET_KEY=
# سر Webhook من Stripe (whsec_)
STRIPE_WEBHOOK_SECRET=
# ليس سرًا: رابط الموقع المنشور، مثل https://daman.replit.app
APP_ORIGIN=
